{
  "name": "sola",
  "version": "0.1.0",
  "private": true,
  "description": "Sola \u2014 Gold Shop POS and Inventory Management System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @sola/api",
    "dev:web": "npm run dev -w @sola/web",
    "seed": "npm run seed -w @sola/api",
    "test": "npm test -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "build": "npm run build -w @sola/web",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}